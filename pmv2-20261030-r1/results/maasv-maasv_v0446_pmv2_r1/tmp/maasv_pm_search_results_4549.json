            "all_options": "(a) \u6700\u8fd1\u5982\u679c\u89c9\u5f97\u538b\u529b\u5927\uff0c\u4e0d\u59a8\u5728\u508d\u665a\u7684\u65f6\u5019\u53bb\u6d77\u8fb9\u6563\u6b65\uff0c\u7136\u540e\u56de\u5bb6\u8bd5\u8bd5\u505a\u51e0\u9053\u81ea\u5df1\u559c\u6b22\u7684\u70d8\u7119\u751c\u70b9\uff0c\u8ba9\u53a8\u623f\u91cc\u5145\u6ee1\u6e29\u6696\u7684\u9999\u6c14\u3002\u542c\u7740\u8f7b\u97f3\u4e50\u914d\u5408\u6162\u52a8\u4f5c\u70d8\u7119\uff0c\u53ef\u4ee5\u5e2e\u4f60\u628a\u601d\u7eea\u653e\u677e\u4e0b\u6765\u3002\u7a7a\u95f2\u65f6\u4e5f\u53ef\u4ee5\u7ffb\u4e00\u7ffb\u81ea\u5df1\u6536\u85cf\u7684\u65c5\u884c\u5730\u56fe\uff0c\u60f3\u60f3\u4e0b\u4e00\u6b21\u7684\u63a2\u9669\u8def\u7ebf\u3002\n(b) \u6700\u8fd1\u5982\u679c\u89c9\u5f97\u538b\u529b\u5927\uff0c\u4e0d\u59a8\u5728\u508d\u665a\u7684\u65f6\u5019\u53bb\u6d77\u8fb9\u6563\u6b65\uff0c\u7136\u540e\u56de\u5bb6\u6ce1\u4e00\u58f6\u9999\u7247\u7ec6\u7ec6\u54c1\u5473\uff0c\u8ba9\u8336\u9999\u6162\u6162\u6c81\u5165\u5fc3\u795e\u3002\u542c\u7740\u8f7b\u97f3\u4e50\u914d\u5408\u6e29\u70ed\u8336\u6c64\uff0c\u53ef\u4ee5\u5e2e\u4f60\u628a\u601d\u7eea\u653e\u677e\u4e0b\u6765\u3002\u7a7a\u95f2\u65f6\u4e5f\u53ef\u4ee5\u7ffb\u4e00\u7ffb\u81ea\u5df1\u6536\u85cf\u7684\u65c5\u884c\u5730\u56fe\uff0c\u60f3\u60f3\u4e0b\u4e00\u6b21\u7684\u63a2\u9669\u8def\u7ebf\u3002\n(c) \u6700\u8fd1\u5982\u679c\u89c9\u5f97\u538b\u529b\u5927\uff0c\u4e0d\u59a8\u5728\u508d\u665a\u7684\u65f6\u5019\u51fa\u95e8\u6563\u6563\u6b65\uff0c\u7136\u540e\u56de\u5bb6\u505a\u4e00\u9879\u8ba9\u81ea\u5df1\u653e\u677e\u7684\u6d3b\u52a8\uff0c\u6bd4\u5982\u8bfb\u4e66\u6216\u4f38\u5c55\u8fd0\u52a8\u3002\u914d\u5408\u6df1\u547c\u5438\uff0c\u53ef\u4ee5\u5e2e\u4f60\u628a\u601d\u7eea\u6162\u6162\u653e\u677e\u4e0b\u6765\u3002\u7a7a\u95f2\u65f6\u4e5f\u53ef\u4ee5\u60f3\u4e00\u60f3\u672a\u6765\u53ef\u4ee5\u5b89\u6392\u7684\u5047\u671f\u8ba1\u5212\u3002\n(d) \u6700\u8fd1\u5982\u679c\u89c9\u5f97\u538b\u529b\u5927\uff0c\u4e0d\u59a8\u5728\u508d\u665a\u7684\u65f6\u5019\u53bb\u6d77\u8fb9\u6563