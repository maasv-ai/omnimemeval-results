            "all_options": "(a) \u5468\u672b\u665a\u4e0a\u4e0d\u59a8\u5148\u548c\u670b\u53cb\u53bb\u770b\u4e00\u573a\u7535\u5f71\uff0c\u7136\u540e\u5230\u6d77\u8fb9\u5439\u5439\u98ce\u3001\u62cd\u51e0\u5f20\u591c\u666f\u7167\uff0c\u65e2\u6709\u5a31\u4e50\u4e5f\u6709\u4f60\u559c\u6b22\u7684\u81ea\u7136\u98ce\u5149\u4f5c\u966a\u3002\n(b) \u5468\u672b\u665a\u4e0a\u4f60\u53ef\u4ee5\u9009\u62e9\u53bb\u5546\u573a\u901b\u901b\uff0c\u968f\u610f\u5403\u70b9\u4e1c\u897f\uff0c\u7136\u540e\u5728\u5bb6\u770b\u5267\u6253\u53d1\u65f6\u95f4\uff0c\u8fd9\u6837\u5b89\u6392\u7b80\u5355\u53c8\u7701\u5fc3\u3002\n(c) \u53ef\u4ee5\u5b89\u6392\u548c\u670b\u53cb\u5728\u5468\u672b\u665a\u4e0a\u6311\u4e00\u90e8\u90fd\u611f\u5174\u8da3\u7684\u7247\u5b50\u4e00\u8d77\u770b\uff0c\u770b\u5b8c\u540e\u987a\u9053\u53bb\u6563\u4e2a\u6b65\u6216\u5bb5\u591c\uff0c\u8ba9\u6574\u4e2a\u665a\u4e0a\u90fd\u5145\u6ee1\u60ec\u610f\u7684\u6c1b\u56f4\u3002\n(d) \u5468\u672b\u665a\u4e0a\u4f60\u53ef\u4ee5\u7ea6\u670b\u53cb\u4e00\u8d77\u53bb\u770b\u4e00\u90e8\u8f7b\u677e\u7684\u7535\u5f71\uff0c\u4e4b\u540e\u627e\u4e00\u5bb6\u5b89\u9759\u7684\u5496\u5561\u9986\u5750\u5750\uff0c\u804a\u804a\u6700\u8fd1\u7684\u8da3\u4e8b\uff0c\u8fd9\u6837\u65e2\u653e\u677e\u53c8\u6e29\u6696\u3002",
